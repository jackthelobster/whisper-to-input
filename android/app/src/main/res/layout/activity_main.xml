<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/app_background"
        app:title="@string/whisper_to_input"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settings_top_bar"
        app:layout_constraintBottom_toTopOf="@id/settings_bottom_bar">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                style="@style/SettingsDescription"
                android:layout_marginBottom="16dp"
                android:text="@string/settings_intro" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout style="@style/CardContents">
                    <TextView style="@style/SettingsLabel" android:text="@string/setup_title" />
                    <TextView style="@style/SettingsDescription" android:text="@string/setup_description" />
                    <TextView android:id="@+id/microphone_status" style="@style/SetupStatus" android:text="@string/microphone_needed" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_permission"
                        style="@style/SetupButton"
                        android:text="@string/grant_microphone_permission"
                        app:icon="@drawable/ic_dictation_mic" />
                    <TextView android:id="@+id/keyboard_status" style="@style/SetupStatus" android:text="@string/keyboard_not_enabled" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_enable_keyboard"
                        style="@style/SetupButton"
                        android:text="@string/enable_keyboard"
                        app:icon="@drawable/ic_dictation_keyboard" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_choose_keyboard"
                        style="@style/SetupButton"
                        android:text="@string/choose_keyboard"
                        app:icon="@drawable/ic_dictation_switch" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout style="@style/CardContents">
                    <TextView style="@style/SettingsLabel" android:text="@string/server_title" />
                    <TextView style="@style/SettingsDescription" android:text="@string/server_description" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_endpoint"
                        style="@style/SettingsInput"
                        android:hint="@string/settings_endpoint"
                        app:helperText="@string/settings_endpoint_desc">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/field_endpoint"
                            style="@style/SettingsField"
                            android:inputType="textUri"
                            android:imeOptions="actionNext"
                            android:maxLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_model"
                        style="@style/SettingsInput"
                        android:hint="@string/settings_model">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/field_model"
                            style="@style/SettingsField"
                            android:inputType="textNoSuggestions"
                            android:imeOptions="actionNext"
                            android:maxLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_language"
                        style="@style/SettingsInput"
                        android:hint="@string/settings_language_code"
                        app:helperText="@string/settings_language_code_desc">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/field_language_code"
                            style="@style/SettingsField"
                            android:inputType="textNoSuggestions"
                            android:imeOptions="actionNext"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_api_key"
                        style="@style/SettingsInput"
                        android:hint="@string/settings_api_key"
                        android:importantForAutofill="noExcludeDescendants"
                        android:saveEnabled="false"
                        app:helperText="@string/settings_api_key_desc">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/field_api_key"
                            style="@style/SettingsField"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone|flagNoPersonalizedLearning"
                            android:importantForAutofill="noExcludeDescendants"
                            android:saveEnabled="false"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_allow_insecure"
                        style="@style/SettingsSwitch"
                        android:text="@string/allow_insecure" />
                    <TextView
                        style="@style/SettingsDescription"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/http_warning" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_test_connection"
                        style="@style/SetupButton"
                        android:text="@string/test_connection"
                        app:icon="@drawable/ic_dictation_connection" />
                    <TextView
                        android:id="@+id/connection_result"
                        style="@style/SettingsDescription"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:visibility="gone" />
                    <TextView
                        style="@style/SettingsDescription"
                        android:layout_marginTop="8dp"
                        android:text="@string/test_connection_description" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout style="@style/CardContents">
                    <TextView style="@style/SettingsLabel" android:text="@string/behavior_title" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_auto_record"
                        style="@style/SettingsSwitch"
                        android:text="@string/settings_auto_recording_start" />
                    <TextView style="@style/SettingsDescription" android:text="@string/settings_auto_recording_start_desc" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_auto_switch"
                        style="@style/SettingsSwitch"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings_auto_switch_back" />
                    <TextView style="@style/SettingsDescription" android:text="@string/settings_auto_switch_back_desc" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_trailing_space"
                        style="@style/SettingsSwitch"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings_add_trailing_space" />
                    <TextView style="@style/SettingsDescription" android:text="@string/settings_add_trailing_space_desc" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/settings_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/app_surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:enabled="false"
            android:text="@string/settings_btn_apply"
            android:textAllCaps="false"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_dictation_check" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

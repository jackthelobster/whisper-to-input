<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboard_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dictation_keyboard"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_previous_ime"
        style="@style/KeyboardKey"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:contentDescription="@string/btn_previous_ime_hint"
        app:srcCompat="@drawable/ic_dictation_switch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_settings"
        style="@style/KeyboardKey"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:contentDescription="@string/open_settings"
        app:srcCompat="@drawable/ic_dictation_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <LinearLayout
        android:id="@+id/status_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/btn_previous_ime"
        app:layout_constraintEnd_toStartOf="@id/btn_settings"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/label_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_ready"
            android:textColor="@color/app_on_surface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:accessibilityLiveRegion="polite" />
        <TextView
            android:id="@+id/label_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/keyboard_ready_hint"
            android:textColor="@color/app_on_surface_variant"
            android:textSize="12sp"
            android:gravity="center"
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/btn_mic_frame"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status_group">
        <View
            android:id="@+id/mic_amplitude_ring"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_dictation_amplitude"
            android:alpha="0.15"
            android:visibility="invisible"
            android:importantForAccessibility="no"
            android:clickable="false"
            android:focusable="false" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_mic"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_dictation_mic"
            android:tint="@color/app_on_primary"
            android:padding="24dp"
            android:contentDescription="@string/start_speech_to_text"
            app:srcCompat="@drawable/ic_dictation_mic" />
        <ProgressBar
            android:id="@+id/pb_waiting_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/app_on_primary"
            android:visibility="gone"
            android:importantForAccessibility="no"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_cancel"
        style="@style/KeyboardKey"
        android:contentDescription="@string/cancel_dictation"
        android:visibility="invisible"
        app:srcCompat="@drawable/ic_dictation_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_mic_frame"
        app:layout_constraintTop_toTopOf="@id/btn_mic_frame"
        app:layout_constraintBottom_toBottomOf="@id/btn_mic_frame" />
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_retry"
        style="@style/KeyboardKey"
        android:contentDescription="@string/retry_dictation"
        android:visibility="invisible"
        app:srcCompat="@drawable/ic_dictation_retry"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_mic_frame"
        app:layout_constraintTop_toTopOf="@id/btn_mic_frame"
        app:layout_constraintBottom_toBottomOf="@id/btn_mic_frame" />
    <com.example.whispertoinput.keyboard.BackspaceButton
        android:id="@+id/btn_backspace"
        style="@style/KeyboardKey"
        android:contentDescription="@string/backspace_button_hint"
        app:srcCompat="@drawable/ic_dictation_backspace"
        app:layout_constraintStart_toEndOf="@id/btn_mic_frame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_mic_frame"
        app:layout_constraintBottom_toBottomOf="@id/btn_mic_frame" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_space_bar"
        style="@style/KeyboardKey"
        android:layout_width="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/desc_space_bar"
        app:srcCompat="@drawable/ic_dictation_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_enter"
        app:layout_constraintTop_toBottomOf="@id/btn_mic_frame"
        app:layout_constraintBottom_toBottomOf="parent" />
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_enter"
        style="@style/KeyboardKey"
        android:contentDescription="@string/enter_key"
        app:srcCompat="@drawable/ic_dictation_enter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_space_bar"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

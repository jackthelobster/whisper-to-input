<resources>
    <style name="Base.Theme.WhisperToInput" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryContainer">@color/app_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/app_on_primary_container</item>
        <item name="colorSecondary">@color/app_primary</item>
        <item name="colorOnSecondary">@color/app_on_primary</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_on_surface</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_on_surface_variant</item>
        <item name="colorOutline">@color/app_outline</item>
        <item name="colorError">@color/app_error</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Theme.WhisperToInput" parent="Base.Theme.WhisperToInput" />
    <style name="SettingsCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardBackgroundColor">@color/app_surface</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="CardContents">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="SettingsLabel" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/app_on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="SettingsDescription" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/app_on_surface_variant</item>
    </style>
    <style name="SetupStatus" parent="SettingsDescription">
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>
    <style name="SetupButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">20dp</item>
    </style>
    <style name="SettingsInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
    <style name="SettingsField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/app_on_surface</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="SettingsSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyLarge</item>
        <item name="android:textColor">@color/app_on_surface</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="switchPadding">12dp</item>
    </style>
    <style name="KeyboardKey">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_dictation_key</item>
        <item name="android:tint">@color/app_on_surface</item>
        <item name="android:padding">16dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <style name="RegularText"><item name="android:textColor">@color/app_on_surface</item></style>
    <style name="RegularImage"><item name="android:tint">@color/app_on_surface</item></style>
    <style name="Background"><item name="android:background">@color/app_background</item></style>
    <style name="TopBar"><item name="android:background">@color/app_outline</item></style>
</resources>

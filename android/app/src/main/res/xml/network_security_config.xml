<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Arbitrary user-configured tailnet hosts require OS cleartext permission.
         EndpointPolicy requires explicit opt-in before every probe and upload. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

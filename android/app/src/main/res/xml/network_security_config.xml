<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- EndpointPolicy enforces the user HTTP switch before every probe and upload.
         Android must permit cleartext for user-configured hosts; TLS uses system CAs. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
